<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="#FF1A1A2E">

    <!-- 状态栏（工作区） -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        android:background="#1AFFFFFF">

        <Button
            android:id="@+id/back_to_launcher"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/btn_home_back"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="连接: --"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/job_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="队列: 0"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ① 语音输入（无图片：居中麦克风 + 按住说话） -->
    <LinearLayout
        android:id="@+id/voice_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_launcher_bg"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="20dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/ptt_button"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@null"
            android:contentDescription="@string/btn_ptt"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic" />

        <TextView
            android:id="@+id/hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="按住说话"
            android:textColor="#FF312E81"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#FF312E81"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- ② 生成等待 -->
    <LinearLayout
        android:id="@+id/generating_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_launcher_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/generating_progress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="@android:color/holo_orange_light" />

        <TextView
            android:id="@+id/generating_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🎨 AI 正在生成图片..."
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/cancel_gen_button"
            android:layout_width="60dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_cancel"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ③ 图片预览（符合 doc/7：左 A5 照片区 + 右 232dp 控制栏） -->
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_launcher_bg"
        android:clickable="true"
        android:focusable="true"
            android:paddingTop="20dp"
            android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 左：照片区，按 A5 横向比例 √2:1 + 相框，32dp 留作右下多余空间 -->
            <FrameLayout
                android:id="@+id/preview_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/photo_frame_bg"
                app:layout_constraintDimensionRatio="H,1.4142:1"
                android:layout_marginStart="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/toolbar">

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/preview_pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/preview_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/preview_transcript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#80000000"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:padding="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/cancel_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:background="#66000000"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="@string/btn_cancel"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 右：固定 130dp 控制栏（保存 + 打印 + 按住说话）— weight 均分高度 -->
            <!-- 130dp × 2（density）= 260px，预览区 764×540px = √2:1 -->
            <LinearLayout
                android:id="@+id/toolbar"
                android:layout_width="130dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingVertical="12dp"
                android:paddingHorizontal="14dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <Button
                    android:id="@+id/btn_save_preview"
                    style="@style/BigButton"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="@string/preview_save" />

                <Button
                    android:id="@+id/btn_print_preview"
                    style="@style/BigButton"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="1dp"
                    android:text="@string/preview_print" />

                <Button
                    android:id="@+id/ptt_bar_button"
                    style="@style/BigButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2"
                    android:layout_marginTop="1dp"
                    android:drawableTop="@drawable/ic_mic"
                    android:text="按住说话" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>

    <!-- 底部工具栏 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="#1AFFFFFF"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/print_confirm_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/btn_confirm"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_settings"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_settings" />
    </LinearLayout>

    <!-- 儿童主界面启动器 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/launcher_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_launcher_bg"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="40dp"
        android:visibility="visible">

        <!-- 应用网格（一行横向） -->
        <LinearLayout
            android:id="@+id/launcher_grid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:layout_constraintBottom_toTopOf="@id/launcher_footer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 彩色涂鸦 -->
            <FrameLayout
                android:id="@+id/launcher_card_paint"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_color_painting" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/launcher_paint_zh"
                        android:textColor="#FF312E81"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- 线稿涂色 -->
            <FrameLayout
                android:id="@+id/launcher_card_lineart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_line_art" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/launcher_lineart_zh"
                        android:textColor="#FF312E81"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- 安静小书 -->
            <FrameLayout
                android:id="@+id/launcher_card_quiet"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_quiet_book" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/launcher_quiet_zh"
                        android:textColor="#FF312E81"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- 我的相册 -->
            <FrameLayout
                android:id="@+id/launcher_card_album"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_album" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/launcher_album_zh"
                        android:textColor="#FF312E81"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/launcher_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom|end"
            android:orientation="horizontal"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/launcher_settings_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_settings" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/btn_settings"
                    android:textColor="#FF5B4D7A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 共享状态栏（所有模式通用）— 高度 40dp，符合 doc/7 §4 -->
    <FrameLayout
        android:id="@+id/launcher_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:visibility="gone">

        <!-- 左组：打印机状态 + 返回按钮 + 标题 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 返回按钮（左上，工作区模式可见） -->
            <ImageButton
                android:id="@+id/header_back_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                android:visibility="gone" />

            <!-- 主页标题（主页可见/工作区隐藏） -->
            <TextView
                android:id="@+id/header_launcher_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:text="奇想印印"
                android:textColor="#FF312E81"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 模式标题（工作区可见/主页隐藏）居中 -->
        <TextView
            android:id="@+id/header_mode_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:text=""
            android:textColor="#FF312E81"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 右侧：状态指示 + 时间 + 设置 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/status_wifi"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="WiFi"
                android:src="@drawable/ic_wifi" />

            <ImageView
                android:id="@+id/status_cloud"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:contentDescription="云端"
                android:src="@drawable/ic_cloud" />

            <ImageView
                android:id="@+id/status_battery"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:contentDescription="电量"
                android:src="@drawable/ic_battery" />

            <TextView
                android:id="@+id/header_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text=""
                android:textColor="#FF312E81"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
