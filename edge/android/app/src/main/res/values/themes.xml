<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 主主题 — 儿童 kiosk 全屏深色 -->
    <style name="Theme.FancyPrint" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#FF6750A4</item>
        <item name="colorPrimaryVariant">#FF4B3784</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">#FF03DAC6</item>
        <item name="colorSecondaryVariant">#FF018786</item>
        <item name="colorOnSecondary">#FF000000</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- 透明 Activity 主题（USB 权限请求等） -->
    <style name="TransparentActivity" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Doc §7: 右侧工具栏按钮（weight 均分高度，宽高在 layout 中控制） -->
    <!-- 320dpi 下 8dp × 2 = 16px 圆角，匹配 doc/7 设计 -->
    <style name="BigButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
    </style>
    <style name="BigButton.Primary">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
