<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- USB（ZINK USB 打印） -->
    <uses-permission android:name="android.permission.USB_PERMISSION" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- 音频 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 启动与设备管理 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 存储（日志、离线队列） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".FancyPrintApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FancyPrint"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- EdgeDaemonService：常驻前台服务，管理打印 / 音频 / 云连接 -->
        <service
            android:name=".service.EdgeDaemonService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:persistent="true">
            <intent-filter>
                <action android:name="com.fancyprint.edge.action.START_DAEMON" />
            </intent-filter>
        </service>

        <!-- 打印机发现（USB） -->
        <activity
            android:name=".print.UsbPermissionActivity"
            android:exported="false"
            android:theme="@style/TransparentActivity" />

        <!-- 主 Kiosk Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:lockTaskMode="if_whitelisted"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 打印确认 -->
        <activity
            android:name=".ui.PrintConfirmActivity"
            android:exported="false"
            android:lockTaskMode="if_whitelisted"
            android:screenOrientation="landscape" />

        <!-- 家长锁 -->
        <activity
            android:name=".ui.ParentLockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/TransparentActivity" />

        <!-- 设置 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:lockTaskMode="if_whitelisted"
            android:screenOrientation="landscape" />

        <!-- 开机自启动接收器 -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- 设备管理员（DPC / Lock Task Mode） -->
        <receiver
            android:name=".security.DeviceAdminReceiver"
            android:exported="false"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- MQTT 服务（Eclipse Paho） -->
        <service android:name="org.eclipse.paho.android.service.MqttService" />

        <!-- Print Job Service（JobScheduler 离线重试） -->
        <service
            android:name=".print.PrintJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- FileProvider（OTA APK 安装） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
