# ============================================================
# fancy-print device-api · Environment Configuration
# Copy to .env and fill in the values you need.
# ============================================================
# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ── Auth (device) ─────────────────────────────────────────────────
# JWT secrets for device access/refresh tokens
DEVICE_JWT_ACCESS_SECRET=dev-device-access-secret
DEVICE_JWT_REFRESH_SECRET=dev-device-refresh-secret
# Pre-configured device credentials (JSON object: {"device_id": "secret", ...})
# Overridden by DEVICE_REGISTRY_JSON_PATH if set
DEVICE_DEV_CREDENTIALS={"fancy-print-dev":"fancy-print-secret"}
# Optional JSON file for device registry: {"device_id": "secret", ...}
# or {"devices": [{"id":"...", "secret":"..."}]}
DEVICE_REGISTRY_JSON_PATH=

# ── ASR (choose one; leave both blank to use stub) ──────────────
# Xunfei IAT (讯飞语音听写 WebSocket)
# IFLYTEK_APP_ID=
# IFLYTEK_API_KEY=
# IFLYTEK_API_SECRET=
# IFLYTEK_IAT_HOST=iat-api.xfyun.cn
# IFLYTEK_IAT_ENCODING=raw
# IFLYTEK_IAT_FORMAT=audio/L16;rate=16000
# IFLYTEK_IAT_LANGUAGE=zh_cn
# IFLYTEK_IAT_DOMAIN=iat
# IFLYTEK_IAT_ACCENT=mandarin
# IFLYTEK_IAT_TIMEOUT_MS=55000

# Baidu ASR (百度语音识别 REST API)
# BAIDU_ASR_API_KEY=
# BAIDU_ASR_SECRET_KEY=
# BAIDU_ASR_CUID=fancy-print-device
# BAIDU_ASR_DEV_PID=1537
# BAIDU_ASR_RATE=16000
# BAIDU_ASR_TIMEOUT_MS=30000

# ── Image Generation (choose one) ─────────────────────────────────
# Tongyi Wanxiang (通义万象 DashScope)
# DASHSCOPE_API_KEY=       # same as TONGYI_API_KEY
# TONGYI_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# DASHSCOPE_WORKSPACE_ID=
# WANX_MODEL=wan2.7-image-pro
# WANX_IMAGE_SIZE=1024*1024
# WANX_STYLE=<auto>
# WANX_NEGATIVE_PROMPT=
# WANX_HTTP_TIMEOUT_MS=120000

# Baidu Wenxin Yige (文心一格)
# IMAGE_GEN_DRIVER=baidu
# BAIDU_IMAGE_GEN_API_KEY=
# BAIDU_IMAGE_GEN_SECRET_KEY=
# WENXIN_STYLE=卡通画
# WENXIN_RESOLUTION=1024*1024
# WENXIN_IMAGE_NUM=1
# WENXIN_HTTP_TIMEOUT_MS=300000

# ── Adapter Selection (auto = auto-detect by credentials) ─────────
# ASR_DRIVER=auto|iflytek|baidu|stub
# IMAGE_GEN_DRIVER=auto|tongyi|baidu|stub

# ── Pipeline (job advancement) ─────────────────────────────────────
# PIPELINE_QUEUE_BACKEND=in-memory|bullmq  (bullmq requires REDIS_URL)
# PIPELINE_QUEUE_CONCURRENCY=8    # BullMQ worker concurrency (max 128)
# PIPELINE_WORKER_STANDALONE=0|1    # Run as pure BullMQ worker (no HTTP)
# DEVICE_API_CLUSTER_WORKERS=      # Multi-core cluster mode (omit for single process)
# JOB_ADVANCE_LOCK_TTL_SEC=30
# JOB_ADVANCE_LOCK_WAIT_MS=5000
# JOB_REDIS_TTL_SEC=604800          # 7 days
# JOB_REDIS_IMPORT_FILE=0|1
# JOB_REDIS_IMPORT_OVERWRITE=0|1
# JOB_FILE_EXPORT_ON_SHUTDOWN=0|1
# JOB_FILE_EXPORT_PATH=
# JOBS_PERSISTENCE_PATH=            # In-memory job store file path (single instance)

# ── Redis (required for BullMQ / multi-instance) ─────────────────
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_KEY_PREFIX=fp:

# ── MQTT (device status publish / telemetry subscribe) ────────────
# MQTT_URL=                      # e.g. mqtt://127.0.0.1:1883
# MQTT_RECONNECT_MS=1000
# MQTT_SESSION_CLEAN=true
# MQTT_SUBSCRIBE_TELEMETRY=0|1  # Subscribe to devices/+/telemetry

# ── S3 / Object Storage (audio staging & preview) ────────────────
# S3_AUDIO_BUCKET=
# S3_PREVIEW_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_AUDIO_ENDPOINT=
# S3_PREVIEW_ENDPOINT=
# S3_PREVIEW_UPLOAD=0|1
# ASR_SEND_BASE64_WITH_PRESIGNED=0|1   # Also: ASR_HTTP_SEND_BASE64_WITH_PRESIGNED
# IMAGE_GEN_URL_TTL_MS=900000

# ── Content Moderation ─────────────────────────────────────────────
# MODERATION_TEXT_HTTP_URL=
# MODERATION_TEXT_HTTP_TIMEOUT_MS=10000
# MODERATION_TEXT_HTTP_AUTHORIZATION=
# MODERATION_IMAGE_HTTP_URL=
# MODERATION_IMAGE_HTTP_TIMEOUT_MS=15000
# MODERATION_IMAGE_HTTP_AUTHORIZATION=
# MODERATION_HTTP_MAX_RETRIES=3
# MODERATION_HTTP_RETRY_BASE_MS=1000
# MODERATION_HTTP_RETRY_MAX_MS=30000

# ── mTLS (gateway → device-api) ─────────────────────────────────
# MTLS_HEADER_TRUST=0|1
# TRUSTED_PROXY_IPS=127.0.0.1
# MTLS_ALLOWED_DEVICE_IDS_JSON={"device-001":true,"device-002":true}
# MTLS_TRUST_REGISTERED_DEVICES=0|1

# ── Telemetry ──────────────────────────────────────────────────────
# DEVICE_TELEMETRY_LOG_PATH=
# MQTT_SUBSCRIBE_TELEMETRY=0|1

# ── Policy ──────────────────────────────────────────────────────────
# POLICY_JSON_PATH=
# POLICY_CACHE_TTL_MS=60000

# ── Audit Log ──────────────────────────────────────────────────────
# AUDIT_LOG_PATH=
